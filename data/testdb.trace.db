INSERT INTO TRAILS_TBL (id, name, src, description, more_info, how_to_come, ways_in_trail, user_id) 
VALUES (1, 'יער כברי', 'images/trail1.jpg', 
'יער כברי, שעיקרו עצי מחט, משתרע מצפון לנחל געתון, משני צדי כביש צומת כברי-מעלות (כביש 89) בגובה של עד 250 מטר מעל פני הים. שילוב של נתונים טבעיים עם שבילים ואתרים, הופכים את האזור למקום נעים מאוד לטיול. היער אינו גדול במיוחד אך ניתן למצוא בו ובסביבתו מבחר מרשים של מקומות מעניינים לביקור, ובהם חורשים טבעיים ויערות נטועים, אתרי עבר ומורשת קרב, חניונים ומעיינות.', 
'הרי הגליל המערבי משתפלים בהדרגה מגוש הרי מירון מערבה, אל מישור חוף הגליל. בגבעות המערביות ביותר, המתנשאות לגובה של עד 250 מטר מעל פני הים. יער כברי, שעיקרו עצי מחט. היער משתרע מצפון לנחל געתון, משני צדי כביש צומת כברי-מעלות (כביש 89). שילוב של נתונים טבעיים עם שבילים ואתרים הופכים את האזור למקום נעים מאוד לטיול. יער כברי אינו גדול במיוחד, אך ניתן למצוא בו ובסביבתו מבחר מרשים של מקומות מעניינים לביקור, ובהם חורשים טבעיים ויערות נטועים, אתרי עבר ומורשת קרב, חניונים ומעיינות.', 
'נוסעים בכביש 89 (נהריה-מעלות) עד צומת געתון ופונים דרומה לכביש 8833 המוביל לגעתון וליחיעם. נוסעים כ-1.2 ק"מ עד לדרך עפר משולטת הפונה שמאלה. וממשיכים עוד כ-2 ק"מ לפי השילוט.', NULL, 1) [22001-232]
2025-05-11 13:31:06.878544+03:00 jdbc[13]: exception
org.h2.jdbc.JdbcSQLDataException: Value too long for column "HOW_TO_COME CHARACTER VARYING(255)": "U&'\\05de\\05db\\05d1\\05d9\\05e9 38 \\05e4\\05d5\\05e0\\05d9\\05dd \\05d1\\05db\\05e0\\05d9\\0... (318)"; SQL statement:
INSERT INTO TRAILS_TBL (id, name, src, description, more_info, how_to_come, ways_in_trail, user_id) 
VALUES (2, 'נחל המערה', 'images/trail2.jpg', 
'לאורך כל השנה ילוו אתכם במסלול המקסים צמחייה ים תיכונית עשירה, מעיינות נסתרים המרווים את בוסתני הכפרים החרבים, מבצר עתיק גדול ושפע מערות המעטרות את צלעות הגבעות וההרים.', 
'נחל המערה מציע מספר חלופות לטיול: מסלול שאורכו כ-7 ק"מ ומשכו 4-6 שעות: מסלול לא קשה להליכה, המתאים למשפחות. המסלול המלא אינו מעגלי ויש להשאיר רכב בסוף המסלול, כמתואר מטה. מסלול קצר יותר - אורכו כ-3 ק"מ: מסלול מעגלי שמתאים למשפחות, וכולל ביקור בחרבת בית עיטאב ועין חוד. הביקור במערת התאומים נעשה בנפרד. המסלולים מרהיבים ביופיים כל השנה, אך בחודשי החורף (נובמבר-מרץ) מערת התאומים סגורה כדי להגן על העטלפים המתגוררים בה וישנים את שנת החורף. שימו לב: יש להצטייד לפחות ב-3 ליטר מים לאדם, כובע, קרם שיזוף ופנס חובה.', 
'מכביש 38 פונים בכניסה הצפונית לבית שמש מזרחה לכביש 3855 בעקבות השילוט לעבר אזור התעשייה. עוברים את בית שמש וממשיכים עד לפניה שמאלה לעבר נס הרים ובר גיורא. לאחר כ-9 ק"מ רואים מצד ימין שלט המפנה לעבר חרבת בית עיטאב עם סימון שבילים כחול עליו. אם פספסתם, תגיעו לאחר 300 מטר, בצד שמאל של הדרך תחנת מידע של רשות הטבע והגנים.', NULL, 1) [22001-232]
