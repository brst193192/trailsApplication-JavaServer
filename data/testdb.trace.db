INSERT [dbo].[TrailsTbl] ([Id], [Name], [Src], [Description], [MoreInfo], [HowToCome], [WaysInTrail], [UserId]) VALUES (3, N'יער כברי', N'images/trail1.jpg', N'יער כברי, שעיקרו עצי מחט, משתרע מצפון לנחל געתון, משני צדי כביש צומת כברי-מעלות (כביש 89) בגובה של עד 250 מטר מעל פני הים. שילוב של נתונים טבעיים עם שבילים ואתרים, הופכים את האזור למקום נעים מאוד לטיול. היער אינו גדול במיוחד אך ניתן למצוא בו ובסביבתו מבחר מרשים של מקומות מעניינים לביקור, ובהם חורשים טבעיים ויערות נטועים, אתרי עבר ומורשת קרב, חניונים ומעיינות.', N'הרי הגליל המערבי משתפלים בהדרגה מגוש הרי מירון מערבה, אל מישור חוף הגליל. בגבעות המערביות ביותר, המתנשאות לגובה של עד250 מטר מעל פני הים. יער כברי, שעיקרו עצי מחט. היער משתרע מצפון לנחל געתון, משני צדי כביש צומת כברי-מעלות (כביש 89).
שילוב של נתונים טבעיים עם שבילים ואתרים הופכים את האזור למקום נעים מאוד לטיול. יער כברי אינו גדול במיוחד, אך ניתן למצוא בו ובסביבתו מבחר מרשים של מקומות מעניינים לביקור, ובהם חורשים טבעיים ויערות נטועים, אתרי עבר ומורשת קרב, חניונים ומעיינות', N'נוסעים בכביש 89 (נהריה-מעלות) עד צומת געתון ופונים דרומה לכביש 8833 המוביל לגעתון וליחיעם. נוסעים כ-1.2 ק''מ עד לדרך עפר משולטת הפונה שמאלה. וממשיכים עוד כ-2 ק''מ לפי השילוט.', NULL, 1)
INSERT [dbo].[TrailsTbl] ([Id], [Name], [Src], [Description], [MoreInfo], [HowToCome], [WaysInTrail], [UserId]) VALUES (4, N'נחל המערה', N'images/trail2.jpg', N'לאורך כל השנה ילוו אתכם במסלול המקסים צמחייה ים תיכונית עשירה, מעיינות נסתרים המרווים את בוסתני הכפרים החרבים, מבצר עתיק גדול ושפע מערות המעטרות את צלעות הגבעות וההרים.', N'נחל המערה מציע מספר חלופות לטיול: מסלול שאורכו כ-7 ק"מ ומשכו 4-6 שעות: מסלול לא קשה להליכה, המתאים למשפחות. המסלול המלא אינו מעגלי ויש להשאיר רכב בסוף המסלול, כמתואר מטה. מסלול קצר יותר - אורכו כ-3 ק"מ: מסלול מעגלי שמתאים למשפחות, וכולל ביקור בחרבת בית עיטאב ועין חוד. הביקור במערת התאומים נעשה בנפרד. המסלולים מרהיבים ביופיים כל השנה, אך בחודשי החורף (נובמבר-מרץ) מערת התאומים סגורה כדי להגן על העטלפים המתגוררים בה וישנים את שנת החורף. שימו לב: יש להצטייד לפחות ב-3 ליטר מים לאדם, כובע, קרם שיזוף ופנס חובה.', N'מכביש 38 פונים בכניסה הצפונית לבית שמש מזרחה לכביש 3855 בעקבות השילוט לעבר אזור התעשייה. עוברים את בית שמש וממשיכים עד לפניה שמאלה לעבר נס הרים ובר גיורא [1] (שימו לב לשילוט). אם אתם מגיעים בשני רכבים, בנקודה זו כדאי לעבור להנחיות להשארת הרכב השני טרם שפונים). מצומת זה פונים ומתחילים לטפס עם הכביש (3866). לאחר כ-9 ק"מ רואים מצד ימין שלט המפנה לעבר חרבת בית עיטאב עם סימון שבילים כחול עליו. אם פספסתם, תגיעו לאחר 300 מטר, בצד שמאל של הדרך תחנת מידע של רשות הטבע והגנים [3]. ניתן לחנות את הרכב או בתחנת המידע או בסמוך לבית הקברות (300 מטרים הבדל). שימו לב כי גם ללא רכב שני ניתן לעשות את המסלול במלא אורכו ולהסתייע במונית מבית שמש או בטרמפ כדרך חזרה למכונית בתחילת המסלול. השארת רכב שני את הרכב השני משאירים בסוף דרך העפר [10] , שהכניסה אליה חצי קילומטר דרומית למושב זנוח על כביש 3855. חצי קילומטר לאחר הפניה לדרך העפר [2] ישנה רחבת עפר גדולה בה נחנה את הרכב.', NULL, 1)
INSERT [dbo].[TrailsTbl] ([Id], [Name], [Src], [Description], [MoreInfo], [HowToCome], [WaysInTrail], [UserId]) VALUES (5, N'הר הרוח ושביל נוף יתלה', N'images/trail3.jpg', N'הרי ירושלים נשפכים אל מישור החוף בשלוחות, וביניהן גיאיות ונחלים. בשלוחה שמצפון לכביש 1 שוכן הר הרוח, שנטוע ביערות קק"ל ומהווה מקום מקסים לפיקניק וטיול רגלי קצר. צאו לקילומטר וחצי בלבד של הליכה בנופי נחל יתלה, היפה כל השנה ובמיוחד עכשיו כשמסביב הכל ירוק.', N'בחלק הצפון מערבי של מורדות הר הרוח נחנך בשנת 1995, במלאת חמישים שנה לסיום מלחמת העולם השניה, יער זיכרון ליהדות פולין. הירידה מן הכביש מלווה באנדרטת אבן יפה המזכירה את הקהילות שחיו בפולין טרום השואה. ביער נמצאת גם אבן הנצחה לזכרו של יאנוש קורצאק ועוזרתו סטפה וילצינסקה שנספו בטרבלינקה.  אנו נסע עם הדרך המסומנת בסימון שבילים אדום, שהופכת לאחר מרחק קצר לדרך סלולה.', N'מכביש תל אביב-ירושלים (כביש 1) פונים במחלף עין חמד-אבו גוש לכיוון אבו גוש, נטף ומעלה החמישה. הכביש עובר בכפר אבו גוש, המוכר היטב בזכות החומוסיות שלו, וקצת פחות בזכות הכנסיה היפה שבו. בחלקו העליון של הכפר פונה הכביש ימינה לכיוון נטף ומעלה החמישה. לאחר כמה מאות מטרים ישנה פניה שמאלה לכיוון נטף (הפנייה ימינה מובילה למעלה החמישה). נפנה שמאלה וניסע עם הכביש מערבה. נחלוף על פני פנייה לדרך העפר להר הרוח (סימון שבילים כחול) ונמשיך בכביש הראשי, עד שנגיע לפנייה שמאלה ליער יהדות פולין ודרך עפר המסומנת בסימון שבילים אדום.  אם הגעתם לכניסה לישוב נטף, סימן שפיספסתם את הפניה ועליכם לשוב בחזרה.', NULL, 2)
INSERT [dbo].[TrailsTbl] ([Id], [Name], [Src], [Description], [MoreInfo], [HowToCome], [WaysInTrail], [UserId]) VALUES (6, N'מערות המבוך בבית גוברין –ארץ המערות', N'images/trail4.jpg', N'גן לאומי ארכיאולוגי מרתק בניהולה של רשות הטבע והגנים. בגן תטיילו מערכת מערות תת קרקעיות קדומות. ביקור במערות בית גוברין הוא מסע מרתק בארץ המערות. הפארק עצום בגודלו וכולל לא פחות מ– 500 מערות וכוכים.', N'ירידה במדרגות לוליינות אל תוך בתי מגורים אשר בתוך מערכת תת קרקעית של חדרים : חדרי רחצה; בורות מים ועוד. מה שיפה זה המעברים בין החדרים. המערות שימשו כמתחם קבורה מפואר ומרשים. המערות השתמרו באופן כל כך טוב. כך שהכניסה אליהן יוצרת תחושה מיוחדת של חזרה מאות שנים אחורנית.', N'להזין בוויז מערות בית גוברין.', NULL, 1)
INSERT [dbo].[TrailsTbl] ([Id], [Name], [Src], [Description], [MoreInfo], [HowToCome], [WaysInTrail], [UserId]) VALUES (44, N'יד קנדי, חרבת סעדים ושביל המעיינות', N'images/trail7.jpg', N'בין הרי ירושלים מסתתרים מאות מעיינות, שפורצים מתוך ההר ומרווים את הצומח שסביבם. לאורך השנים למד האדם לנצל את מי המעיינות להשקיית שטחים חקלאיים מעובדים, וכיום נותרו מהכפרים שהיו במקום בעיקר אותם מעיינות ונקבות מים, וכן בוסתנים מלאי עצים וכל טוב. הנוף המרהיב של הרי ירושלים יעטוף אתכם לכל אורך המסלול, שמתאים לכל עונות השנה.', N'ניתן ליהנות מהמסלול בצורה מעגלית או להאריך אותו ולסיים בנקודה שונה מנקודת ההתחלה. הוא מתאים לכל גיל ועובר בין בריכות מים קרירות. ביער עמינדב עצמו שפע של מסלולי רכיבה לחובבי טיולים האופנים.
מסלול הטיול המתואר כולל שני חלקים:
1.	סיור מעגלי קצר בחרבת סעדים ועין סעדים (בו יש מים רק בימי החורף).
2.	מסלול שאינו מעגלי בשביל המעיינות, שמתחיל בחרבת סעדים ומסתיים באזור הכניסה לבית החולים הדסה עין כרם. אורכו כ-3 ק"מ.
ניתן לעשות את כל אחד מן המסלולים בנפרד או לשלבם למסלול אחד.

', N'הגעה לתחילת המסלול: נוסעים בכביש תל אביב-ירושלים, יורדים במחלף הראל לכיוון דרום, עוברים את מוצא ומעוז ציון וממשיכים עד לכיכר גדולה בה פונים שמאלה ונוסעים בכיוון בית החולים הדסה עין כרם. ממשיכים לפי השילוט לעבר בית החולים, עוברים אותו לכיוון צומת אורה, ובו פונים מערבה, לעבר הישובים אורה ועמינדב, בעקבות השילוט ליד קנדי וחרבת סעדים. עוברים את שני הישובים וממשיכים להר עמינדב, בכיוון השילוט ליד קנדי.
נקודת הסיום של שביל המעיינות: בכביש הגישה המוביל מאזור בית החולים הדסה לעבר היישוב אבן ספיר. יש להקפיץ רכב אחד לסוף המסלול ולהשאיר אותו שם. הדרך הפשוטה ביותר היא לנסוע בדרך עפר (שמתאימה לכל רכב), המסומנת בסימון שבילים אדום. דרך העפר מתחילה בחלקה המזרחי של חרבת סעדים (מפגש סימונים שחור ואדום) ומסתיימת בדיוק בנקודה שבה מסתיים המסלול, בחיבור עם הכביש המוביל לאבן ספיר .
', NULL, 4)
INSERT [dbo].[TrailsTbl] ([Id], [Name], [Src], [Description], [MoreInfo], [HowToCome], [WaysInTrail], [UserId]) VALUES (46, N'מצפה משואה', N'images/trail8.jpg', N'באזור שפלת יהודה היפהפה, בין בית שמש לבית גוברין, מסתתר מסלול טיול רגלי וקליל, המתאים לכל אחד ומשלב נוף משובב, של חורש ארצישראלי ואתרים ארכיאולוגיים מעניינים. באביב מנקדת את המסלול פריחה צבעונית בשלל צבעים.', N'מצפה משואה הוא אתר קק"ל ובו מגדל מבטון, המשמש לתצפית שרפות. לצדו אזור שולחנות פיקניק עם ברזיה ושירותים.
את השם משואה קיבל המקום על שם משואות לכיש, שנזכרות בתנ"ך. משואות אלו הדליקו במקומות גבוהים בין הישובים ביהודה במטרה להעביר הודעות או מסרים. בתקופת בית שני השיאו משואות בעיקר כדי להכריז על תחילתו של ראש חודש ולהפיץ זאת בין שאר הישובים היהודים.

', N'ההגעה למצפה משואה היא על כביש 38 מכיוון בית שמש. עוברים את צומת האלה, עוברים את הפניה לליאון, עג''ור ולוזית ומיד לאחר מכן רואים שלט ימינה על הכביש לכביש קטן, שמעלה אותנו למצפה משואה. סימן היכר ברור לצד הכביש הקטן הזה – עץ דקל מלאכותי וגבוה במיוחד, שמשמש דקורציה להסתרה בנוף של אנטנה של אחת מחברות הסלולר. באותה צומת תראו גם שלט לפניה שמאלה לפארק עדולם וחורבת מדרס.', NULL, 2)
INSERT [dbo].[TrailsTbl] ([Id], [Name], [Src], [Description], [MoreInfo], [HowToCome], [WaysInTrail], [UserId]) VALUES (47, N'נחל אל-על', N'images/trail9.jpg', N'המסלול בנחל אל על לוקח אותנו לביקור בשמורת הטבע היפהפייה שעוטפת אותו. הנחל האיתן זורם באופן קבוע ומפורסם בעיקר בזכות תופעה גאולוגית מיוחדת בדמות שני המפלים שבו: המפל השחור, הוא המייצג של המסלע ברמת הגולן הבזלתית שהיא בצבע שחור ומכאן גם לקוח שמו. אבל בהמשך הנחל, המסלע משתנה לאבן גיר לבנה, וזהו צבעו של הסלע באזור המפל השני הידוע גם בשמו - המפל הלבן. מתחת לכל מפל יש כמובן בריכה, שמזמינה לטבול להשתכשך בה.', N'בחניון יש מזנון (פתוח על פי תיאום מראש), ברזי מים ושירותים. מכאן נמשיך צפונה בשביל המסומן אדום לאורך גדר המושב עד לתחילת הירידה לערוץ העמוק של נחל אל על. אם תקשיבו היטב אולי תוכלו לשמוע את להקת הזאבים הפרועים, החמורים, הצבועים, השועלים, דורבנים, לוטרות, נמיות ושפני סלע. כל אלו נמצאים בשמורה וכדי לראותם צריך לבוא בשעות החשיכה. 
בנקודת תחילת הירידה מומלץ לעשות תצפית. ניתן לראות החל מהחרמון בצפון ועד הכנרת, ניתן לראות גם את היישוב אלי-עד שבהמשך הנחל – המקום בו נסיים את הטיול שלנו. 
הירידה עצמה לא פשוטה ויש להיזהר. לפני שמגיעים לערוץ הנחל נעבור בבוסתן שבימי הקיץ נמצא בו תאנים, רימונים, ענבים, עצי רימון , משוכות צבר תמרים ועוד. לאחר ההגעה לאפיק המרשים עולים מעט לגדה הצפונית (הימנית) וממשיכים בשביל המתפתל בין הצמחייה.
', N'מצומת אפיק ממשיכים בכביש 98 לכיוון מגשימים עד לפניה לאבני איתן. ניתן להכנס עם הרכב עד לחניון המפלים, שממנו מתחיל השביל האדום היורד לנחל.', NULL, 2)
INSERT [dbo].[TrailsTbl] ([Id], [Name], [Src], [Description], [MoreInfo], [HowToCome], [WaysInTrail], [UserId]) VALUES (48, N'מערת התאומים', N'images/trail10.jpg', N'מערת התאומים היא מערה יפהפייה הנמצאת בשפלת יהודה לא הרחק מן העיר בית שמש, על התוואי של נחל מערה בתוך שטחה של שמורת נחל דולב. ההליכה אל המערה אורכת מהחניון של השמורה כ 30 דקות, מרחק של כ 1 קילומטר. במהלך הדרך יש הליכה על גבי סלעים חלקים , אך על דאגה יש מעקים בהם ניתן להיעזר. בפתח המערה ניצב עץ תאנה ענקי ששורשיו מסתעפים אל תוך הפתח.', N'המערה עמוקה ובעלת חלל עצום. אורכה של המערה כ 75 מטרים והרוחב שלה כ 50 מטרים. תקרתה מאוד גבוהה ומפותלת.בתוך המערה יש כ 3000 עטלפים מזנים שונים מרביתם עטלפי חרקים. 
בשנת 2009, גילו ארכיאולוגים שהמערה שימשה אנשים בתקופת מרד בר כוכבא זאת. בזכות ממצאים כגון : עצמות ,חרסים ומטבעות שהתגלו בה. 
המערה חשוכה לחלוטין וחייבים להגיע עם פנס. לכל אורכה תפגשו בנטיפים ובניצבים יפהפיים ואף יטפטפו עליכם טיפות מים התקרה. 
לאורך כל הטיול במערה שאורך כ 20 דקות. תשמעו שריקות אילו הם העטלפים הרבים הגרים בה. האירו על תקרתה ותגלו המון נטיפים. 
בסוף המסלול במערה תגלו בריכה מרובעת ויפה עם מים. אדוות מים נוצרות כתוצאות מטיפות שנופלות מהתקרה, ומציירות בה עיגולים. 
שימו לב המערה סגורה בין החודשים נובמבר עד מרץ. זוהי שנת החורף של העטלפים ולכן אסור להיכנס אליה.

', N'במחלף שער הגיא. פונים ימינה לכיוון כביש 38 -בית שמש. 
אחרי משטרת בית שמש , פונים שמאלה בכביש החדש שעוקף את בית שמש. כביש 3855 עוברים את הכיכרות וממשיכים ישר. 
עושים פניית פרסה שמבחינים בשלט מחצבה. נוסעים חזרה לכיוון זנוח ואז רואים של חום ” מערת התאומים” – עולים על דרך עפר עד שמגיעים לחניון.

', NULL, 1)
INSERT [dbo].[TrailsTbl] ([Id], [Name], [Src], [Description], [MoreInfo], [HowToCome], [WaysInTrail], [UserId]) VALUES (52, N'נחל חלילים', N'images/trail11.jpg', N'נחל חלילים העירוני שוכן בין בתי מבשרת ציון בואכה כביש 1 העמוס, והוא מהוו ריאה ירוקה בלב הבטון והאספלט. המסלול מתאים לכל גיל, והגישה הפשוטה לתחילתו ולסופו הופכות אותו לאידיאלי, במיוחד בתקופת האביב הפורח. בתחתית הנחל נמצא פארק עמק הארזים עם שלל משחקים לילדים.', N'המסלול אינו מסומן וכדי להתחיל את המסלול יש להיכנס לפארק מצד ימין דרך השער הירוק. השביל לאורך הנחל מסומן בצבע ירוק. תחילה חולפים בין עצי תאנה גדולים שמלבלבים עם בוא הקיץ. הטרסות הנטושות וצמחיית המעזבות שביניהן מעידות על התיישבות אדם במקום. סימון שבילים שקוף (שני פסים לבנים ללא צבע ביניהם) יוביל אותנו לאתר העתיקות חורבת המוצה,  שלידה צומח עץ שקד גדול. 
אנו נמשיך בשביל הירוק כעשר דקות נוספות, עד למערת חלילים.
לאחר ששבענו ממראה המערה, נרד ממנה בזהירות ונמשיך לאורך הנחל. בדרכינו נראה את הבוסתנים היפים ששוכנים בינות לטרסות, שמנצלות את אופיו הגיאולוגי של הנחל. בין עצי הפרי תבחינו גם בעצי חורש טבעיים: עוזרר, אשחר, וכמובן האלה הארץ ישראלית. במפגש של נחל חלילים עם נחל שורק הרחב נראה חורשה נטועה קטנה של עצי אורן וברוש מרשימים בגודלם בסמוך למגרש חניה. נקודה זו מומלצת לעצירה קלה. 
משם נגיע לחלקו המערבי של פארק עמק הארזים שבמרכזו עובר קטעו העליון של נחל שורק. 
בהמשך נפנה שמאלה לביקור בעינות תלם .דרך העפר, המסומנת בסימון שבילים כחול, תוביל אותנו עד מהרה למפגש נחל שורק עם נחל לוז ושלידו נמצאת חורבת בית תלם. 
מעינות תלם, נחזור על צעדינו בנחל שורק עד למקום שבו נמצא הרכב השני או בחזרה לנקודת ההתחלה.
 
', N'מכביש 1 (ירושלים-תל אביב) פונים במחלף הראל לעבר מבשרת ציון, חולפים על פני קניון הראל וממשיכים בנסיעה ברחוב הראל. בכיכר הראשונה פונים ימינה (רחוב ברוש), ואחר כך בפנייה הראשונה שמאלה (רחוב השלום). נוסעים ברחוב השלום כ-100 מטר עד לרחבת החנייה של בית ספר השלום, וממנה יורדים לחלקת השדה בגיא הרדוד, שמצפון לבית-הספר. כאן נמצאת ראשיתו של נחל חלילים.', NULL, 4)
INSERT [dbo].[TrailsTbl] ([Id], [Name], [Src], [Description], [MoreInfo], [HowToCome], [WaysInTrail], [UserId]) VALUES (62, N'עמק הנרקיסים פי גלילות – נחל אחיה', N'images/trail12.jpg', N'עמק הנרקיסים אשר בשכונת רמת -אביב ג’, הינו שדה פרחים מופלא שבחודשי החורף פורח. זהו אתר פריחת נרקיסים מהיפים באזור המרכז.
בחודשי החורף דצמבר -ינואר ותחילת פברואר – שדה חיטה שלא הוכשר לבנייה והפך לריאה הירוקה של השכונות הצפוניות בתל-אביב. כולו  עוטה בצבעים ירוק – צהוב -לבן ונראה למרחקים. צרורות נרקיסים על השדה הירוק הם לא אחר מאשר מספר רב של נרקיסים המרוכזים. ממש כמו זרי פרחים שהטבע מעניק חינם לכל דורש, למי שיגיע לטייל ולבקר במקום היפהפה הזה.', N'השביל המוביל אל עמק הנרקיסים ,המתחיל ממרכז רוזין ברחוב דרזנר 1 תל-אביב שם נמצאים צופי השכונה. ישנה ירידה מאזור החנייה אל תוך מסלול יפהפה המואר בפרחי טיון צהובים. בהמשך הדרך זורם נחל אחיה שהוא יובלו המערבי של נחל הירקון ובחודשי החורף הוא זורם ופעיל.
בחודשי חורף גשומים מאוד שהכל מוצף מהגשמים, נחל אחיה מנקז את מימי הגשמים מאזור הכפר הירוק .
נחל אחיה נמצא ממש כעמוד טווח בין עמק הנרקיסים לבין שביל ההליכה המוביל אליו. ההגעה אל האטרקציה הפורחת הזו נעשה או דרך נקודה בנחל בה זרימת המים חלשה. ויש לקפוץ ולנתר מעל זרזיפי המים. ומשם אפשר בקלות לעבור לשדה האינסופי של הנרקיסים. אפשרות שנייה היא דרך “גבעת המזבלה”. הנמצאת מהצד המזרחי של שדה הנרקיסים. שימו לב כדי לראות את הנרקיסים יש להגיע עד לשדה עצמו כי זה מה שתראו מרחוק.
באזור ישנן גם מערות עתיקות הנקראות מערות אפקה, אנחנו לא הספקנו להגיע בגלל שהגענו קצת מאוחר והתחיל להחשיך אבל מי שיבוא מוקדם יותר יוכל בהחלט לשלב זאת בטיול הפריחה הנהדר הזה. נחל אחיה נסוב וזורם ליד ומתחת לפארק הנרקיסים היפה, אזור פורח זה הוא אחרוני המעוזים של פארקים אקולוגיים משמעותיים באזור גוש דן הידוע בצפיפותו הרבה. הפארק הגדול והיחיד שניתן להגדירו כפארק אקולוגי משמעותי הוא פארק אריאל שרון.
', N'בוויז : הזינו “מרכז רוזין” .
מאזור החנייה, יש מעבר פתוח אל תוך אזור פתוח עם שבילים. שימו לב יש בוץ בשבילים לכו בזהירות ברגע שירדתם מהחנייה פנו שמאלה ולכו עם השבילים עד לשלב שתגיעו לשדרת עצים. משמאלה תראו את נחל אחיה זורם מתחת ומעברו השני את עמק הנרקיסים.', NULL, 3)
INSERT [dbo].[TrailsTbl] ([Id], [Name], [Src], [Description], [MoreInfo], [HowToCome], [WaysInTrail], [UserId]) VALUES (63, N'עין מטע, חורבת חנות ושביל הקיסר', N'images/trail13.jpg', N'הסיור בחרבת חנות, עין מטע ושביל הקיסר בנוי משני חלקים שניתן לעשות לחוד או ביחד:
אפשרות ראשונה: טיול מעגלי לעין מטע ועין תנור. הסיור מתחיל ומסתיים בחרבת חנות, אורכו כ-1.5 ק"מ, והוא כולל עלייה לא קשה בסופו.
אפשרות שנייה: טיול קווי ההולך בירידה קלה של כ-3 ק"מ מחרבת חנות, לאורך שביל הקיסר עד לנקודת בית הבד.
הטיול מתאים לכל גיל אך אינו נגיש לעגלות.', N'מחרבת חנות, נצא למסלול מעגלי אל עין מטע ועין תנור. אורכו של המסלול כ-1.5 ק"מ, והוא כולל עלייה בסופו חזרה לחרבת חנות. הירידה למעיינות מומלצת מאוד למרות העלייה בסוף המסלול. מי שלא רוצה יכול להמשיך ישר לתאור המסלול בשביל הקיסר הממשיך מחרבת חנות.
מחניון חרבת חנות יוצאת דרך עפר המסומנת בסימון שבילים כחול. לאחר כ-2 דקות הליכה דרך העפר מתפצלת לדרך עפר נוספת בסימון אדום ולשביל הליכה בסימון שחור. אנו נרד בשביל השחור במורד השלוחה לעבר עין מטע, שנמצא בנחל זנוח. המעיין נמצא בסמוך לעצי אקליפטוס גדולים ומספר מבנים נטושים, וקל למצוא אותו. מי המעיין מתנקזים לבריכה קטנה ורדודה שנעים לטבול בה רגליים.
מעיין מטע נמשיך לביקור במעיין נוסף - עין תנור [6]. כדי להגיע למעיין נחזור מעט על עקבותינו ולאחר כ-50 מטר נגיע למפגש עם דרך עפר המסומנת בסימון אדום, שיורדת בנחל לכיוון מערב. נלך בדרך זו כ-300 מטר מערבה עם הנחל ונגיע לפנייה שמאלה מדרך העפר לעין תנור [6]. נקודת הפנייה שמאלה למעיין, מסומנת בסימון שבילים שקוף שמאלה מדרך העפר. הפנייה הזו אינה ברורה דיה ויש לשים לב היטב לסימון על האבן בצד הדרך המעיד על הפנייה שמאלה למעיין.
עין תנור הינו מעיין נקבה שנמצא בין עצי תאנה ולימון מרשימים. הנקבה נחצבה כדי להגיע עמוק יותר לעבר מקור המים כדי להגדיל את שפיעתו. המים בנקבה מגיעים במקומות העמוקים ביותר עד הברך ובעזרת פנס מומלץ להיכנס לנקבה עד סופה. לאחר הביקור במעיין נחזור על עקבותינו, בחזרה לשביל השחור ועימו נעלה בחזרה לחרבת חנות כדי להתחיל את ההליכה בשביל הקיסר.
שביל הקיסר החדש הוא שביל משודרג ובטוח שיורד מאזור “בית היערן” אל חניון בית הבד”. השביל החדש שמשולט ומסומן בשחור עובר דרך יער אורנים נטוע, שרידי חורש טבעי ומשטחי סלע טבעיים שעוברים לאורכם של שרידי גת עתיקה. המטיילים במקום יוכלו ליהנות מתצפיות נהדרות אל בית שמש, הרי השפלה והרי יהודה המתנשאים לגובה.
תחילתו של השביל השחור עוברת בדרך סלולה המסומנת בירוקה, שיוצאת מכביש 375 וממוקמת מול הכניסה לחורבת חנות, לכיוון דרום אל יער יערן. כעבור כ-800 מטר מימינכם תוכלו להבחין בשלט הכניסה לשביל. לקראת סיומו של המסלול, השביל מתפצל לכיוון המדרגות הרומיות ויוצר תוואי מעגלי עבור מטיילים שלא מעוניינים ללכת את כל המסלול.
השביל שמסומן באדום, מהווה את המקטע שנשאר מהשביל המקורי, המוביל מחניון בית הבד אל המדרגות הקדומות ובחזרה באותה דרך ואורכו כ-750 מטרים לכיוון. בסמוך לחניון תמצאו את שרידיו של בית בד קדום אשר מנגנון הסחיטה שלו דומה לבורג עשוי מעץ.
בשביל תמצאו חיבור חדש בין השביל האדום והשחור שיוצר מסלול מעגלי שאורכו כ-2 ק”מ. המסלול החדש יוצא מחניון בית הבד אל המדרגות הקדומות וחוזר אל בית הבד דרך השלוחה עם השביל השחור, או לחילופין בכיוון ההפוך.', N'נוסעים בכביש ירושלים-תל אביב (כביש 1) עד מחלף שער הגיא. פונים דרומה לכיוון בית שמש וכביש 38. בדרך עוברים ליד הישובים צרעה ואשתאול, העיר בית שמש ומנזר בית ג''ימאל. מגיעים לצומת האלה ופונים שמאלה (מזרחה) בכביש 375. עוברים את קיבוץ נתיב הל"ה משמאלנו ואת תחנת הלוויינים של עמק האלה. בצומת עדולם וצומת עציונה ממשיכים ישר ומטפסים בכביש לכיוון צור הדסה ומבוא ביתר.', NULL, 2)
